{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/((?!api/|_vercel/).*)",
      "has": [
        {
          "type": "host",
          "value": "controlmymac-site.vercel.app"
        }
      ],
      "destination": "https://www.controlmymac.com/$1",
      "permanent": true
    },
    {
      "source": "/get",
      "destination": "/app",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/download.dmg",
      "destination": "/api/download-dmg"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/maintain-offers",
      "schedule": "17 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
